# =============================================================================
# msmtprc — SMTP Client Configuration for Gmail Alert Emails
# Project: An Empirical Evaluation of Severity-Based Alerting in ELT Pipelines
# =============================================================================
# Uses Gmail SMTP with TLS and App Password authentication.
# Credentials are injected via environment variables at runtime.
# =============================================================================

defaults
auth           on
tls            on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
logfile        /app/logs/msmtp.log

account        gmail
host           smtp.gmail.com
port           587
from           ${SMTP_FROM}
user           ${SMTP_USERNAME}
password       ${SMTP_PASSWORD}

account default : gmail
